# Copiar para .env no Coolify — NUNCA commitar .env com valores reais

PORT=4022

GREENHOUSE_USERNAME=troque-o-usuario
GREENHOUSE_PASSWORD=troque-por-uma-senha-forte
# Gerar segredo: openssl rand -hex 32
GREENHOUSE_SESSION_SECRET=troque-por-um-segredo-longo-aleatorio

# Onde o SQLite de histórico é gravado dentro do container (mapeado para
# /pendriver/greenhouse_hist no host via volume no docker-compose.yml)
GREENHOUSE_HIST_DIR=/data

# Opcional: forçar a porta serial manualmente se a auto-detecção falhar
# (ver `docker logs greenhouse` para saber qual porta foi detectada)
# GREENHOUSE_SERIAL_PORT=/dev/ttyUSB0

# Opcional: câmera do DVR via go2rtc (ver go2rtc.yaml.example). Só precisa
# mudar se o nome do stream no go2rtc.yaml ou a URL do serviço for diferente
# do padrão (container "go2rtc" na mesma rede docker).
# GREENHOUSE_GO2RTC_URL=http://go2rtc:1984
# GREENHOUSE_CAMERA_STREAM=estufa
